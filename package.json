{
  "name": "@bitspark/bitruntime",
  "version": "0.7.0",
  "description": "Addressless endpoints, addressed access, byte-keyed trees, local pairs and WebSocket carriers.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bitspark/bitruntime.git",
    "directory": ""
  },
  "exports": {
    "./core": {
      "types": "./dist/core/ts/src/index.d.ts",
      "import": "./dist/core/ts/src/index.js"
    },
    "./websocket": {
      "types": "./dist/websocket/ts/src/index.d.ts",
      "import": "./dist/websocket/ts/src/index.js"
    },
    "./hydrated": {
      "types": "./dist/hydrated/ts/src/index.d.ts",
      "import": "./dist/hydrated/ts/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check": "tsc -p tsconfig.check.json",
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test --test-timeout=30000 \"core/ts/test/*.test.mjs\" \"websocket/ts/test/*.test.mjs\" \"hydrated/ts/test/*.test.mjs\""
  },
  "dependencies": {
    "@bitspark/bitwire": "0.6.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@bitspark/deixis-core": "0.6.0",
    "@types/node": "24.19.0",
    "@types/ws": "8.18.2",
    "typescript": "5.9.3"
  }
}
